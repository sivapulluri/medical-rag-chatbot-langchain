# Required for Gemini answer generation and image analysis
GEMINI_API_KEY=put_your_key_here

# Optional Gemini chat model override
GEMINI_MODEL=gemini-2.5-flash-lite

# Optional local embedding model override
# Changing this requires rebuilding the Chroma vector database.
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Render only: set both paths under your persistent disk mount.
# Example mount path: /var/data
# EMBEDDING_CACHE_PATH=/var/data/fastembed
# VECTORSTORE_PATH=/var/data/chroma_db

RAG_DEBUG=1
